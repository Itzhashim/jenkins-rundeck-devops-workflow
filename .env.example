# ==============================================================================
# Environment Configuration Template
# DO NOT COMMIT ACTUAL SECRETS OR KEYS TO VERSION CONTROL.
# Copy this file to .env for local testing or configure these in Jenkins/Rundeck.
# ==============================================================================

# --- Azure Virtual Machine IPs & Hostnames ---
JENKINS_SERVER_IP=20.xxx.xxx.xxx
RUNDECK_SERVER_IP=20.yyy.yyy.yyy
APP_DEPLOY_PORT=8080

# --- SSH Credentials (For Jenkins -> Rundeck / Target VM communication) ---
SSH_USER=azureuser
SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa

# --- Rundeck Configuration & Authentication ---
RUNDECK_URL=http://20.yyy.yyy.yyy:4440
RUNDECK_API_VERSION=45
RUNDECK_API_TOKEN=your-rundeck-user-api-token-here
RUNDECK_PROJECT_NAME=DevOps-Automation
RUNDECK_DEPLOY_JOB_UUID=7b8e5c12-3456-4789-a1b2-c3d4e5f60002

# --- Jenkins Configuration ---
JENKINS_URL=http://20.xxx.xxx.xxx:8080
JENKINS_USER=admin
JENKINS_API_TOKEN=your-jenkins-api-token-here
